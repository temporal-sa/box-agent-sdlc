# Obtain these existing network values from the registry platform's nonsecret
# OpenTofu outputs and EKS describe-cluster metadata. Never copy its state.
aws_account_id         = "429214323166"
vpc_id                 = "vpc-REPLACE"
private_subnet_ids     = ["subnet-REPLACE-a", "subnet-REPLACE-b"]
eks_security_group_ids = ["sg-REPLACE-cluster"]
# operator_security_group_ids = ["sg-REPLACE-private-management-host"]
region                  = "us-west-1"
project_name            = "box-agent-sdlc"
db_instance_class       = "db.t4g.small"
multi_az                = true
